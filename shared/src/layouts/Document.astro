---
import { languageRssPath, siteConfig, sitePath, textDirection, ui } from '../lib/site'
import Shell from '../theme/Shell.astro'
import '../styles/fonts.generated.css'
import '../styles/typography.css'
import '../styles/runtime.css'
import '../theme/theme.css'

type Alternate = { language: string; href: string }
type Props = {
  title?: string
  description?: string
  contentLanguage: string
  kind?: 'website' | 'article'
  publishedAt?: Date
  sources?: readonly string[]
  alternates?: readonly Alternate[]
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  contentLanguage,
  kind = 'website',
  publishedAt,
  sources = [],
  alternates = [],
} = Astro.props
const documentTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined
const defaultAlternate = alternates.find((alternate) => alternate.language === siteConfig.defaultContentLanguage)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': kind === 'article' ? 'NewsArticle' : 'WebSite',
  name: kind === 'website' ? siteConfig.name : undefined,
  headline: kind === 'article' ? title : undefined,
  description,
  url: canonical,
  datePublished: publishedAt?.toISOString(),
  inLanguage: contentLanguage,
  author: kind === 'article' ? { '@type': 'Organization', name: siteConfig.authorName } : undefined,
  publisher: { '@type': 'Organization', name: siteConfig.publisherName },
  citation: sources.length > 0 ? sources : undefined,
}
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c')
const style = [
  `--primary:${siteConfig.primaryColor}`,
  `--accent:${siteConfig.accentColor}`,
  `--background:${siteConfig.backgroundColor}`,
  `--surface:${siteConfig.surfaceColor}`,
  `--text:${siteConfig.textColor}`,
  `--muted:${siteConfig.mutedColor}`,
  `--content-width:${siteConfig.maxWidth}`,
  `--card-radius:${siteConfig.cardRadius}`,
].join(';')
---

<!doctype html>
<html lang={siteConfig.locale} dir={textDirection(siteConfig.locale)} data-theme={siteConfig.theme} style={style}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={siteConfig.primaryColor} />
    <title>{documentTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.language} href={alternate.href} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={languageRssPath(contentLanguage)} />
    <meta property="og:type" content={kind} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={contentLanguage.replace('-', '_')} />
    {canonical && <meta property="og:url" content={canonical} />}
    {siteConfig.socialImageUrl && <meta property="og:image" content={siteConfig.socialImageUrl} />}
    <meta name="twitter:card" content={siteConfig.socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {siteConfig.socialImageUrl && <meta name="twitter:image" content={siteConfig.socialImageUrl} />}
    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skipToContent}</a>
    <Shell contentLanguage={contentLanguage}>
      <slot />
    </Shell>
  </body>
</html>
