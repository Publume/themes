---
import SearchPage from '../../components/SearchPage.astro'
import Document from '../../layouts/Document.astro'
import { languageSearchPath, siteConfig, ui } from '../../lib/site'

export function getStaticPaths() {
  return siteConfig.outputLanguages
    .filter((language) => language !== siteConfig.defaultContentLanguage)
    .map((language) => ({ params: { language }, props: { contentLanguage: language } }))
}

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
const alternates = Astro.site
  ? siteConfig.outputLanguages.map((language) => ({
      language,
      href: new URL(languageSearchPath(language), Astro.site).href,
    }))
  : []
---

<Document title={ui.search} description={ui.searchDescription} contentLanguage={contentLanguage} kind="search" alternates={alternates} noindex>
  <SearchPage contentLanguage={contentLanguage} />
</Document>
