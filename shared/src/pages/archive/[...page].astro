---
import { getCollection } from 'astro:content'
import ArchivePage from '../../components/ArchivePage.astro'
import Document from '../../layouts/Document.astro'
import { archivePageSize, articlesForLanguage } from '../../lib/articles'
import { languageArchivePath, siteConfig, textDirection, ui } from '../../lib/site'

export async function getStaticPaths() {
  const allArticles = await getCollection('articles')
  const articles = articlesForLanguage(allArticles, siteConfig.defaultContentLanguage)
  const pageCount = Math.max(1, Math.ceil(articles.length / archivePageSize))
  return Array.from({ length: pageCount }, (_, index) => ({
    params: { page: index === 0 ? undefined : `page/${index + 1}` },
    props: { allArticles, articles, page: index + 1, pageCount },
  }))
}

type Props = {
  allArticles: Awaited<ReturnType<typeof getCollection<'articles'>>>
  articles: Awaited<ReturnType<typeof getCollection<'articles'>>>
  page: number
  pageCount: number
}
const { allArticles, articles, page, pageCount } = Astro.props
const contentLanguage = siteConfig.defaultContentLanguage
const pageArticles = articles.slice((page - 1) * archivePageSize, page * archivePageSize)
const alternates = Astro.site
  ? siteConfig.outputLanguages.flatMap((language) => {
      const pages = Math.max(1, Math.ceil(articlesForLanguage(allArticles, language).length / archivePageSize))
      return page <= pages ? [{ language, href: new URL(languageArchivePath(language, page), Astro.site).href }] : []
    })
  : []
---

<Document
  title={page === 1 ? ui.archive : `${ui.archive} · ${ui.page} ${page}`}
  contentLanguage={contentLanguage}
  kind="collection"
  alternates={alternates}
  adPlacement={pageArticles.length > 0 ? 'archiveInline' : undefined}
>
  <div lang={contentLanguage} dir={textDirection(contentLanguage)}>
    <ArchivePage articles={pageArticles} contentLanguage={contentLanguage} page={page} pageCount={pageCount} total={articles.length} />
  </div>
</Document>
