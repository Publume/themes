---
import { getCollection } from 'astro:content'
import AdSlot from '../components/AdSlot.astro'
import Document from '../layouts/Document.astro'
import { articlesForLanguage, homeArticleLimit } from '../lib/articles'
import { languageHomePath, siteConfig, textDirection } from '../lib/site'
import { sourcesForLanguage } from '../lib/sources'
import Home from '../theme/Home.astro'

const contentLanguage = siteConfig.defaultContentLanguage
const allArticles = await getCollection('articles')
const articles = articlesForLanguage(allArticles, contentLanguage)
const sourceCount = sourcesForLanguage(allArticles, contentLanguage).length
const alternates = Astro.site
  ? siteConfig.outputLanguages.map((language) => ({
      language,
      href: new URL(languageHomePath(language), Astro.site).href,
    }))
  : []
---

<Document contentLanguage={contentLanguage} alternates={alternates} adPlacement="homeAfterFeed">
  <div lang={contentLanguage} dir={textDirection(contentLanguage)}>
    <Home
      articles={articles.slice(0, homeArticleLimit)}
      total={articles.length}
      sourceCount={sourceCount}
      contentLanguage={contentLanguage}
    />
    <AdSlot placement="homeAfterFeed" />
  </div>
</Document>
