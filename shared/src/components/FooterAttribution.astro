---
import { siteConfig, sitePath } from '../lib/site'

type Props = { className?: string }
const { className } = Astro.props
const brand = 'Publume'
const brandIndex = siteConfig.footerText.indexOf(brand)
const beforeBrand = brandIndex < 0 ? siteConfig.footerText : siteConfig.footerText.slice(0, brandIndex)
const afterBrand = brandIndex < 0 ? '' : siteConfig.footerText.slice(brandIndex + brand.length)
---

<p class={className}>
  {beforeBrand}{
    brandIndex >= 0 && (
      <a class="publume-attribution-link" href="https://github.com/Publume">
        <img
          class="publume-attribution-logo"
          src={sitePath('/publume-logo.png')}
          alt=""
          aria-hidden="true"
          width="16"
          height="16"
        />
        {brand}
      </a>
    )
  }{afterBrand}
</p>
