---
import type { Article } from '../lib/articles'
import ArticleCard from '../theme/ArticleCard.astro'
import AdSlot from './AdSlot.astro'

type Props = { articles: readonly Article[]; contentLanguage: string; archive?: boolean }
const { articles, contentLanguage, archive = false } = Astro.props
---

<div class="publume-article-list">
  {articles.map((article, index) => (
    <>
      <ArticleCard article={article} contentLanguage={contentLanguage} />
      {archive && index === Math.min(4, articles.length - 1) && <AdSlot placement="archiveInline" />}
    </>
  ))}
</div>
