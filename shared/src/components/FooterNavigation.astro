---
import { languageRssPath, siteConfig, sitePath, ui } from '../lib/site'

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
---

<nav class="shell publume-footer-navigation" aria-label={`${siteConfig.name} · ${ui.about}`}>
  <a href={sitePath('/about/')}>{ui.about}</a>
  {Astro.site && <a href={languageRssPath(contentLanguage)}>{ui.rss}</a>}
  {siteConfig.contactUrl && <a href={siteConfig.contactUrl} rel="me">{ui.contact}</a>}
</nav>
