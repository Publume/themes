---
import type { Article } from '../lib/articles'
import { articlePath, formatDate, siteConfig, ui, uiLocale } from '../lib/site'

type Props = { articles: readonly Article[]; contentLanguage: string }
const { articles, contentLanguage } = Astro.props
const sourceCount = siteConfig.showSources
  ? new Set(articles.flatMap((article) => article.data.sourceUrls.map((url) => new URL(url).hostname))).size
  : 0
---

<section class="lab-hero shell" lang={uiLocale}>
  <div class="hero-copy"><p class="lab-label">{ui.live} · {ui.monitoring}</p><h1>{siteConfig.tagline}</h1><p>{siteConfig.description}</p>{(siteConfig.newsletterUrl || siteConfig.sponsorUrl) && <div class="hero-actions">{siteConfig.newsletterUrl && <a class="button primary" href={siteConfig.newsletterUrl}>{ui.newsletter}</a>}{siteConfig.sponsorUrl && <a class="button" href={siteConfig.sponsorUrl}>{ui.sponsor}</a>}</div>}</div>
  <dl class="specimen-card"><div class="specimen-graphic" aria-hidden="true"><span><i></i></span></div><div><dt>{ui.published}</dt><dd>{String(articles.length).padStart(2, '0')}</dd></div>{siteConfig.showSources && <div><dt>{ui.sources}</dt><dd>{String(sourceCount).padStart(2, '0')}</dd></div>}</dl>
</section>
<section class="lab-feed shell" aria-labelledby="latest-heading"><div class="section-heading" lang={uiLocale}><div><p class="lab-label">{ui.published}</p><h2 id="latest-heading">{ui.latest}</h2></div><span>{ui.mode}: {ui.live}</span></div>{articles.length > 0 ? <div class="study-grid">{articles.map((article, index) => <article class:list={['study-card', { featured: index === 0 }]}><div class="study-number"><span>{String(index + 1).padStart(2, '0')}</span><i aria-hidden="true"></i></div><div class="article-meta"><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, contentLanguage)}</time>{siteConfig.showScore && article.data.score !== undefined && <span lang={uiLocale}>{ui.relevance} {Math.round(article.data.score * 100)}</span>}</div><h2><a href={articlePath(article.id, contentLanguage)}>{article.data.title}</a></h2><p>{article.data.summary}</p>{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list">{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}<a class="read-link" lang={uiLocale} href={articlePath(article.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">→</span></a></article>)}</div> : <div class="empty-state" lang={uiLocale}><span class="molecule" aria-hidden="true"><i></i><i></i><i></i></span><h2>{ui.emptyTitle}</h2><p>{ui.emptyDescription}</p></div>}</section>
