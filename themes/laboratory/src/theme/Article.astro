---
import ArticleDisclosure from '../components/ArticleDisclosure.astro'
import ArticleSources from '../components/ArticleSources.astro'
import type { Article } from '../lib/articles'
import { formatDate, languageHomePath, siteConfig, ui, uiLocale } from '../lib/site'

type Props = { article: Article }
const { article } = Astro.props
---

<article class="article shell"><a class="back-link" lang={uiLocale} href={languageHomePath(article.data.language)}>← {ui.backToHome}</a><header class="article-header"><div class="record-meta"><p class="lab-label" lang={uiLocale}>{ui.published}</p><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, article.data.language)}</time>{siteConfig.showScore && article.data.score !== undefined && <span lang={uiLocale}>{ui.relevance} {Math.round(article.data.score * 100)}</span>}<span class="record-rule" aria-hidden="true"></span></div><div><h1>{article.data.title}</h1><p class="article-summary">{article.data.summary}</p>{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list">{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}</div></header><div class="article-layout"><div class="article-body"><slot /></div><aside class="evidence-rail">{siteConfig.showSources && <ArticleSources urls={article.data.sourceUrls} label={ui.sources} />}<ArticleDisclosure label={ui.disclosure} text={siteConfig.aiDisclosure} headingClass="lab-label" /></aside></div></article>
