---
import type { CollectionEntry } from 'astro:content'
import { formatDate, siteConfig, sitePath } from '../lib/site'

type Props = {
  article: CollectionEntry<'articles'>
  featured?: boolean
}

const { article, featured = false } = Astro.props
---

<article class:list={['article-card', { featured }]}>
  <div class="article-meta">
    <time datetime={article.data.publishedAt.toISOString()}>
      {formatDate(article.data.publishedAt, article.data.language)}
    </time>
    <span aria-hidden="true">·</span>
    <span>{article.data.language.toUpperCase()}</span>
    {siteConfig.showScore && article.data.score !== undefined && (
      <>
        <span aria-hidden="true">·</span>
        <span>{Math.round(article.data.score * 100)} relevance</span>
      </>
    )}
  </div>
  <h2><a href={sitePath(`/${article.id}/`)}>{article.data.title}</a></h2>
  <p>{article.data.summary}</p>
  {siteConfig.showTopics && article.data.topics.length > 0 && (
    <ul class="topic-list" aria-label="Topics">
      {article.data.topics.map((topic) => <li>{topic}</li>)}
    </ul>
  )}
  <a class="read-link" href={sitePath(`/${article.id}/`)} aria-label={`Read ${article.data.title}`}>
    Read article <span aria-hidden="true">→</span>
  </a>
</article>
