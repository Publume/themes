---
import { siteConfig, sitePath, textDirection } from '../lib/site'
import '../styles/global.css'

type Props = {
  title?: string
  description?: string
  language?: string
  kind?: 'website' | 'article'
  publishedAt?: Date
  sources?: readonly string[]
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  language = siteConfig.locale,
  kind = 'website',
  publishedAt,
  sources = [],
} = Astro.props
const documentTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined
const structuredData = {
  '@context': 'https://schema.org',
  '@type': kind === 'article' ? 'NewsArticle' : 'WebSite',
  name: kind === 'website' ? siteConfig.name : undefined,
  headline: kind === 'article' ? title : undefined,
  description,
  url: canonical,
  datePublished: publishedAt?.toISOString(),
  inLanguage: language,
  author: kind === 'article' ? { '@type': 'Organization', name: siteConfig.authorName } : undefined,
  publisher: { '@type': 'Organization', name: siteConfig.publisherName },
  citation: sources.length > 0 ? sources : undefined,
}
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c')
const style = [
  `--primary:${siteConfig.primaryColor}`,
  `--accent:${siteConfig.accentColor}`,
  `--background:${siteConfig.backgroundColor}`,
  `--surface:${siteConfig.surfaceColor}`,
  `--text:${siteConfig.textColor}`,
  `--muted:${siteConfig.mutedColor}`,
  `--content-width:${siteConfig.maxWidth}`,
  `--card-radius:${siteConfig.cardRadius}`,
  `--article-title-max:${siteConfig.articleTitleMaxSize}`,
].join(';')
---

<!doctype html>
<html lang={language} dir={textDirection(language)} data-theme={siteConfig.theme} style={style}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={siteConfig.primaryColor} />
    <title>{documentTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={sitePath('/rss.xml')} />
    <meta property="og:type" content={kind} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {siteConfig.socialImageUrl && <meta property="og:image" content={siteConfig.socialImageUrl} />}
    <meta name="twitter:card" content={siteConfig.socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {siteConfig.socialImageUrl && <meta name="twitter:image" content={siteConfig.socialImageUrl} />}
    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={sitePath('/')} aria-label={`${siteConfig.name} home`}>
          <span class="brand-mark" aria-hidden="true">P</span>
          <span>{siteConfig.name}</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href={sitePath('/')}>Latest</a>
          <a href={sitePath('/rss.xml')}>RSS</a>
          {siteConfig.contactUrl && <a href={siteConfig.contactUrl}>Contact</a>}
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <strong>{siteConfig.name}</strong>
          <p>{siteConfig.aiDisclosure}</p>
        </div>
        <p>{siteConfig.footerText}</p>
      </div>
    </footer>
  </body>
</html>
