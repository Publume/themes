---
import type { Article } from '../lib/articles'
import { articlePath, formatDate, siteConfig, ui } from '../lib/site'

type Props = { articles: readonly Article[]; contentLanguage: string }
const { articles, contentLanguage } = Astro.props
const [featured, ...remaining] = articles
---

<section class="hero shell">
  <p class="eyebrow">{ui.latest}</p>
  <h1>{siteConfig.tagline}</h1>
  <p class="hero-copy">{siteConfig.description}</p>
  {(siteConfig.newsletterUrl || siteConfig.sponsorUrl) && <div class="hero-actions">
    {siteConfig.newsletterUrl && <a class="button primary" href={siteConfig.newsletterUrl}>{ui.newsletter}</a>}
    {siteConfig.sponsorUrl && <a class="button secondary" href={siteConfig.sponsorUrl}>{ui.sponsor}</a>}
  </div>}
</section>
<section class="feed shell" aria-labelledby="latest-heading">
  <div class="section-heading"><div><p class="eyebrow">{ui.published}</p><h2 id="latest-heading">{ui.latest}</h2></div></div>
  {featured ? <>
    <article class="article-card featured">
      <div class="article-meta"><time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt, contentLanguage)}</time></div>
      <h2><a href={articlePath(featured.id, contentLanguage)}>{featured.data.title}</a></h2>
      <p>{featured.data.summary}</p>
      {siteConfig.showTopics && featured.data.topics.length > 0 && <ul class="topic-list" aria-label={ui.topics}>{featured.data.topics.map((topic) => <li>{topic}</li>)}</ul>}
      <a class="read-link" href={articlePath(featured.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">→</span></a>
    </article>
    {remaining.length > 0 && <div class="article-grid">{remaining.map((article) => <article class="article-card">
      <div class="article-meta"><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, contentLanguage)}</time></div>
      <h2><a href={articlePath(article.id, contentLanguage)}>{article.data.title}</a></h2><p>{article.data.summary}</p>
      {siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list" aria-label={ui.topics}>{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}
      <a class="read-link" href={articlePath(article.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">→</span></a>
    </article>)}</div>}
  </> : <div class="empty-state"><h2>{ui.emptyTitle}</h2><p>{ui.emptyDescription}</p></div>}
</section>
