---
import type { Article } from '../lib/articles'
import { formatDate, siteConfig, ui } from '../lib/site'

type Props = { article: Article }
const { article } = Astro.props
---

<article class="article shell">
  <header class="article-header">
    <div class="article-meta"><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, article.data.language)}</time></div>
    <h1>{article.data.title}</h1><p class="article-summary">{article.data.summary}</p>
    {siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list" aria-label={ui.topics}>{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}
  </header>
  <div class="article-body"><slot /></div>
  {siteConfig.showSources && <aside class="sources" aria-labelledby="sources-heading"><p class="eyebrow">{ui.sources}</p><h2 id="sources-heading">{ui.sources}</h2><ol>{article.data.sourceUrls.map((url) => <li><a href={url} rel="noopener noreferrer">{new URL(url).hostname}</a></li>)}</ol></aside>}
  <aside class="disclosure" aria-label={ui.disclosure}><strong>{ui.disclosure}</strong><p>{siteConfig.aiDisclosure}</p></aside>
</article>
