{
  "name": "@publume/theme-editorial",
  "version": "0.1.0",
  "private": true,
  "description": "A fast editorial publication theme for Publume.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
