---
import ArticleDisclosure from '../components/ArticleDisclosure.astro'
import ArticleSources from '../components/ArticleSources.astro'
import type { Article } from '../lib/articles'
import { formatDate, languageHomePath, siteConfig, ui, uiLocale } from '../lib/site'

type Props = { article: Article }
const { article } = Astro.props
---

<article class="article shell"><a class="back-link" lang={uiLocale} href={languageHomePath(article.data.language)}>← {ui.backToHome}</a><header class="article-header"><p class="eyebrow" lang={uiLocale}>{ui.latest}</p><div class="article-meta"><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, article.data.language)}</time>{siteConfig.showScore && article.data.score !== undefined && <span class="score" lang={uiLocale}>{ui.relevance} {Math.round(article.data.score * 100)}</span>}</div><h1>{article.data.title}</h1><p class="article-summary">{article.data.summary}</p>{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list">{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}</header><div class="article-layout"><div class="article-body"><slot /></div><div class="evidence-rail">{siteConfig.showSources && <ArticleSources urls={article.data.sourceUrls} label={ui.sources} />}<ArticleDisclosure label={ui.disclosure} text={siteConfig.aiDisclosure} /></div></div></article>
