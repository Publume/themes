---
import type { Article } from '../lib/articles'
import { formatDate, siteConfig, ui } from '../lib/site'

type Props = { article: Article }
const { article } = Astro.props
---

<article class="article shell"><header class="article-header"><p class="eyebrow">{ui.latest}</p><div class="article-meta"><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, article.data.language)}</time>{siteConfig.showScore && article.data.score !== undefined && <span class="score">{ui.relevance} {Math.round(article.data.score*100)}</span>}</div><h1>{article.data.title}</h1><p class="article-summary">{article.data.summary}</p>{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list" aria-label={ui.topics}>{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}</header><div class="article-layout"><div class="article-body"><slot /></div><div class="evidence-rail">{siteConfig.showSources && <aside class="sources" aria-labelledby="sources-heading"><p class="eyebrow">{ui.sources}</p><h2 id="sources-heading">{ui.sources}</h2><ol>{article.data.sourceUrls.map((url,index) => <li><span>{String(index+1).padStart(2,'0')}</span><a href={url} rel="noopener noreferrer">{new URL(url).hostname}</a></li>)}</ol></aside>}<aside class="disclosure" aria-label={ui.disclosure}><strong>{ui.disclosure}</strong><p>{siteConfig.aiDisclosure}</p></aside></div></div></article>
