---
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import { languageHomePath, languageRssPath, siteConfig, ui } from '../lib/site'

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
---

<div class="system-bar"><div class="shell system-inner"><span><i aria-hidden="true"></i> {ui.live}</span><span>{ui.sources} · {ui.published}</span></div></div>
<header class="site-header"><div class="shell header-inner"><a class="brand" href={languageHomePath(contentLanguage)} aria-label={`${siteConfig.name} · ${ui.home}`}><span class="brand-mark" aria-hidden="true"><b></b><b></b><b></b></span><span>{siteConfig.name}</span></a><nav aria-label={ui.primaryNavigation}><a href={languageHomePath(contentLanguage)}>{ui.latest}</a><a href={languageRssPath(contentLanguage)}>{ui.rss}</a>{siteConfig.contactUrl && <a href={siteConfig.contactUrl}>{ui.contact}</a>}</nav><LanguageSwitcher contentLanguage={contentLanguage} /></div></header>
<main id="main-content"><slot /></main>
<footer class="site-footer"><div class="shell footer-grid"><div><p class="footer-label">{ui.published}</p><strong>{siteConfig.name}</strong></div><div><p class="footer-label">{ui.disclosure}</p><p>{siteConfig.aiDisclosure}</p></div><p class="footer-note">{siteConfig.footerText}</p></div></footer>
