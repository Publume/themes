---
import FooterAttribution from '../components/FooterAttribution.astro'
import FooterNavigation from '../components/FooterNavigation.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import PrimaryNavigation from '../components/PrimaryNavigation.astro'
import { languageHomePath, siteConfig, ui } from '../lib/site'

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
---

<div class="arcade-top"><div class="shell"><span>{ui.live}</span><span>{ui.monitoring}</span></div></div><header class="site-header"><div class="shell header-inner"><a class="brand" href={languageHomePath(contentLanguage)} aria-label={`${siteConfig.name} · ${ui.home}`}><span class="arcade-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{siteConfig.name}</span></a><PrimaryNavigation contentLanguage={contentLanguage} /><LanguageSwitcher contentLanguage={contentLanguage} /></div></header>
<main id="main-content"><slot /></main>
<footer class="site-footer"><div class="shell footer-grid"><div><p class="arcade-label">{ui.published}</p><strong>{siteConfig.name}</strong></div><div><p class="arcade-label">{ui.disclosure}</p><p>{siteConfig.aiDisclosure}</p></div><FooterAttribution /></div><FooterNavigation contentLanguage={contentLanguage} /></footer>
