---
import type { Article } from '../lib/articles'
import { articlePath, formatDate, siteConfig, ui, uiLocale } from '../lib/site'

type Props = { articles: readonly Article[]; contentLanguage: string }
const { articles, contentLanguage } = Astro.props
const sourceCount = siteConfig.showSources
  ? new Set(articles.flatMap((article) => article.data.sourceUrls.map((url) => new URL(url).hostname))).size
  : 0
---

<section class="atlas-hero shell" lang={uiLocale}>
  <div class="atlas-title"><p class="map-label">{ui.monitoring} · {contentLanguage}</p><h1>{siteConfig.tagline}</h1></div>
  <div class="atlas-legend">
    <p>{siteConfig.description}</p>
    <dl><div><dt>{ui.published}</dt><dd>{String(articles.length).padStart(2, '0')}</dd></div>{siteConfig.showSources && <div><dt>{ui.sources}</dt><dd>{String(sourceCount).padStart(2, '0')}</dd></div>}<div><dt>{ui.monitoring}</dt><dd>{ui.live}</dd></div></dl>
    {(siteConfig.newsletterUrl || siteConfig.sponsorUrl) && <div class="hero-actions">{siteConfig.newsletterUrl && <a class="button primary" href={siteConfig.newsletterUrl}>{ui.newsletter}</a>}{siteConfig.sponsorUrl && <a class="button" href={siteConfig.sponsorUrl}>{ui.sponsor}</a>}</div>}
  </div>
</section>
<section class="atlas-feed shell" aria-labelledby="latest-heading">
  <div class="section-heading" lang={uiLocale}><div><p class="map-label">{ui.published}</p><h2 id="latest-heading">{ui.latest}</h2></div><span>{ui.live}</span></div>
  {articles.length > 0 ? <ol class="atlas-registry">{articles.map((article, index) => <li><article class="registry-row">
    <div class="registry-coordinate" aria-hidden="true" lang="en"><span>REG–{String(index + 1).padStart(2, '0')}</span><i></i><b>{String(articles.length - index).padStart(2, '0')}</b></div>
    <div class="registry-entry"><div class="article-meta"><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, contentLanguage)}</time></div><h2><a href={articlePath(article.id, contentLanguage)}>{article.data.title}</a></h2><p>{article.data.summary}</p>{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list">{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}</div>
    <div class="registry-action">{siteConfig.showScore && article.data.score !== undefined && <span lang={uiLocale}>{ui.relevance} {Math.round(article.data.score * 100)}</span>}<a class="read-link" lang={uiLocale} href={articlePath(article.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">→</span></a></div>
  </article></li>)}</ol> : <div class="empty-state atlas-empty" lang={uiLocale}><span class="atlas-empty-mark" aria-hidden="true"><i></i><i></i></span><p class="map-label">{ui.monitoring}</p><h2>{ui.emptyTitle}</h2><p>{ui.emptyDescription}</p></div>}
</section>
