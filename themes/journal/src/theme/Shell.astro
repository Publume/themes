---
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import { languageHomePath, languageRssPath, siteConfig, ui } from '../lib/site'

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
---

<header class="site-header">
  <div class="shell utility-bar">
    <p>{siteConfig.description}</p>
    <nav aria-label={ui.primaryNavigation}><a href={languageHomePath(contentLanguage)}>{ui.latest}</a><a href={languageRssPath(contentLanguage)}>{ui.rss}</a>{siteConfig.contactUrl && <a href={siteConfig.contactUrl}>{ui.contact}</a>}</nav>
  </div>
  <div class="shell masthead"><a class="brand" href={languageHomePath(contentLanguage)} aria-label={`${siteConfig.name} · ${ui.home}`}>{siteConfig.name}</a><p>{siteConfig.tagline}</p><LanguageSwitcher contentLanguage={contentLanguage} /></div>
</header>
<main id="main-content"><slot /></main>
<footer class="site-footer"><div class="shell footer-grid"><div><p class="footer-label">{ui.disclosure}</p><strong>{siteConfig.name}</strong><p>{siteConfig.description}</p></div><div><p class="footer-label">{ui.disclosure}</p><p>{siteConfig.aiDisclosure}</p></div><div class="footer-colophon"><p>{siteConfig.footerText}</p></div></div></footer>
