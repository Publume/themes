---
import FooterAttribution from '../components/FooterAttribution.astro'
import FooterNavigation from '../components/FooterNavigation.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import PrimaryNavigation from '../components/PrimaryNavigation.astro'
import { languageHomePath, siteConfig, ui } from '../lib/site'

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
---

<header class="site-header">
  <div class="shell utility-bar">
    <p>{siteConfig.description}</p>
    <PrimaryNavigation contentLanguage={contentLanguage} />
  </div>
  <div class="shell masthead"><a class="brand" href={languageHomePath(contentLanguage)} aria-label={`${siteConfig.name} · ${ui.home}`}>{siteConfig.name}</a><p>{siteConfig.tagline}</p><LanguageSwitcher contentLanguage={contentLanguage} /></div>
</header>
<main id="main-content"><slot /></main>
<footer class="site-footer"><div class="shell footer-grid"><div><p class="footer-label">{ui.disclosure}</p><strong>{siteConfig.name}</strong><p>{siteConfig.description}</p></div><div><p class="footer-label">{ui.disclosure}</p><p>{siteConfig.aiDisclosure}</p></div><div class="footer-colophon"><FooterAttribution /></div></div><FooterNavigation contentLanguage={contentLanguage} /></footer>
