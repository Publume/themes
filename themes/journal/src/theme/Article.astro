---
import type { Article } from '../lib/articles'
import { formatDate, languageHomePath, siteConfig, ui } from '../lib/site'

type Props = { article: Article }
const { article } = Astro.props
---

<article class="article shell">
  <a class="back-link" href={languageHomePath(article.data.language)}><span aria-hidden="true">←</span> {ui.backToHome}</a>
  <header class="article-header"><p class="article-kicker">{ui.latest}</p><h1>{article.data.title}</h1><p class="article-summary">{article.data.summary}</p><div class="article-byline"><p>{siteConfig.authorName}</p><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, article.data.language)}</time></div>{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list" aria-label={ui.topics}>{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}</header>
  <div class:list={['article-layout', { 'has-sources': siteConfig.showSources }]}><div class="article-main"><div class="article-body"><slot /></div><aside class="disclosure" aria-label={ui.disclosure}><p class="kicker">{ui.disclosure}</p><strong>{ui.disclosure}</strong><p>{siteConfig.aiDisclosure}</p></aside></div>{siteConfig.showSources && <aside class="source-notes" aria-labelledby="sources-heading"><p class="kicker">{ui.sources}</p><h2 id="sources-heading">{ui.sources}</h2><ol>{article.data.sourceUrls.map((url) => <li><a href={url} rel="noopener noreferrer"><span>{new URL(url).hostname}</span><span aria-hidden="true">↗</span></a></li>)}</ol></aside>}</div>
</article>
