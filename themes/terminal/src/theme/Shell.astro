---
import FooterAttribution from '../components/FooterAttribution.astro'
import FooterNavigation from '../components/FooterNavigation.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import PrimaryNavigation from '../components/PrimaryNavigation.astro'
import { languageHomePath, siteConfig, ui } from '../lib/site'

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
---

<div class="terminal-status">
  <div class="shell status-inner">
    <span><i aria-hidden="true"></i>{ui.live}</span>
    <span>{ui.monitoring} / {ui.sources}</span>
  </div>
</div>
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={languageHomePath(contentLanguage)} aria-label={`${siteConfig.name} · ${ui.home}`}>
      <span class="prompt" aria-hidden="true">&gt;_</span><span>{siteConfig.name}</span>
    </a>
    <PrimaryNavigation contentLanguage={contentLanguage} />
    <LanguageSwitcher contentLanguage={contentLanguage} />
  </div>
</header>
<main id="main-content"><slot /></main>
<footer class="site-footer">
  <div class="shell footer-grid">
    <div><span class="prompt" aria-hidden="true">//</span><strong>{siteConfig.name}</strong></div>
    <p>{siteConfig.aiDisclosure}</p>
    <FooterAttribution />
  </div>
  <FooterNavigation contentLanguage={contentLanguage} />
</footer>
