---
import type { Article } from '../lib/articles'
import { articlePath, formatDate, siteConfig, ui } from '../lib/site'

type Props = { articles: readonly Article[]; contentLanguage: string }
const { articles, contentLanguage } = Astro.props
const sourceCount = new Set(articles.flatMap((article) => article.data.sourceUrls.map((url) => new URL(url).hostname)))
  .size
---

<section class="orbit-hero shell"><div class="hero-copy"><p class="orbit-label"><i aria-hidden="true"></i>{ui.live} · {ui.monitoring}</p><h1>{siteConfig.tagline}</h1><p>{siteConfig.description}</p>{(siteConfig.newsletterUrl || siteConfig.sponsorUrl) && <div class="hero-actions">{siteConfig.newsletterUrl && <a class="button primary" href={siteConfig.newsletterUrl}>{ui.newsletter}</a>}{siteConfig.sponsorUrl && <a class="button" href={siteConfig.sponsorUrl}>{ui.sponsor}</a>}</div>}</div><div class="orbit-visual" aria-hidden="true"><span class="planet"><i></i></span><div class="telemetry"><span>{ui.published} <b>{String(articles.length).padStart(2, '0')}</b></span><span>{ui.sources} <b>{String(sourceCount).padStart(2, '0')}</b></span></div></div></section>
<section class="mission-feed shell" aria-labelledby="latest-heading"><div class="section-heading"><div><p class="orbit-label">{ui.published}</p><h2 id="latest-heading">{ui.latest}</h2></div><span>{ui.mode} / {ui.live}</span></div>{articles.length > 0 ? <div class="mission-grid">{articles.map((article, index) => <article class:list={['mission-card', { featured: index === 0 }]}><div class="mission-track"><span>{String(index + 1).padStart(2, '0')}</span><i aria-hidden="true"></i></div><div class="article-meta"><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, contentLanguage)}</time>{siteConfig.showScore && article.data.score !== undefined && <span>{ui.relevance} {Math.round(article.data.score * 100)}</span>}</div><h2><a href={articlePath(article.id, contentLanguage)}>{article.data.title}</a></h2><p>{article.data.summary}</p><div class="card-footer">{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list" aria-label={ui.topics}>{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}<a class="read-link" href={articlePath(article.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">↗</span></a></div></article>)}</div> : <div class="empty-state"><span class="orbit-mark" aria-hidden="true"><i></i></span><h2>{ui.emptyTitle}</h2><p>{ui.emptyDescription}</p></div>}</section>
