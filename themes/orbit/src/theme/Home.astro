---
import type { Article } from '../lib/articles'
import { articlePath, formatDate, siteConfig, ui, uiLocale } from '../lib/site'

type Props = { articles: readonly Article[]; contentLanguage: string }
const { articles, contentLanguage } = Astro.props
const [currentTransmission, ...missionQueue] = articles
const sourceCount = siteConfig.showSources
  ? new Set(articles.flatMap((article) => article.data.sourceUrls.map((url) => new URL(url).hostname))).size
  : 0
---

<section class="orbit-hero shell" lang={uiLocale}>
  <div class="hero-signal"><p class="orbit-label"><i aria-hidden="true"></i>{ui.live} · {ui.monitoring}</p><span>{ui.mode} / {ui.live}</span></div>
  <h1>{siteConfig.tagline}</h1>
  <div class="hero-lower"><div><p>{siteConfig.description}</p>{(siteConfig.newsletterUrl || siteConfig.sponsorUrl) && <div class="hero-actions">{siteConfig.newsletterUrl && <a class="button primary" href={siteConfig.newsletterUrl}>{ui.newsletter}</a>}{siteConfig.sponsorUrl && <a class="button" href={siteConfig.sponsorUrl}>{ui.sponsor}</a>}</div>}</div><div class="orbit-console"><span class="planet" aria-hidden="true"><i></i></span><dl><div><dt>{ui.published}</dt><dd>{String(articles.length).padStart(2, '0')}</dd></div>{siteConfig.showSources && <div><dt>{ui.sources}</dt><dd>{String(sourceCount).padStart(2, '0')}</dd></div>}</dl></div></div>
</section>
<section class="mission-feed shell" aria-labelledby="latest-heading">
  <div class="section-heading" lang={uiLocale}><div><p class="orbit-label">{ui.published}</p><h2 id="latest-heading">{ui.latest}</h2></div><span>{ui.mode} / {ui.live}</span></div>
  {currentTransmission ? <div class="transmission-log"><article class="current-transmission"><div class="current-marker" lang={uiLocale}><span><i aria-hidden="true"></i>{ui.live}</span><b lang="en">TX–01</b></div><div class="current-copy"><div class="article-meta"><time datetime={currentTransmission.data.publishedAt.toISOString()}>{formatDate(currentTransmission.data.publishedAt, contentLanguage)}</time>{siteConfig.showScore && currentTransmission.data.score !== undefined && <span lang={uiLocale}>{ui.relevance} {Math.round(currentTransmission.data.score * 100)}</span>}</div><h2><a href={articlePath(currentTransmission.id, contentLanguage)}>{currentTransmission.data.title}</a></h2><p>{currentTransmission.data.summary}</p>{siteConfig.showTopics && currentTransmission.data.topics.length > 0 && <ul class="topic-list">{currentTransmission.data.topics.map((topic) => <li>{topic}</li>)}</ul>}<a class="read-link" lang={uiLocale} href={articlePath(currentTransmission.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">↗</span></a></div></article>{missionQueue.length > 0 && <ol class="mission-queue">{missionQueue.map((article, index) => <li><article class="queue-entry"><div class="mission-track" aria-hidden="true"><span>{String(index + 2).padStart(2, '0')}</span><i></i></div><div class="queue-copy"><div class="article-meta"><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, contentLanguage)}</time>{siteConfig.showScore && article.data.score !== undefined && <span lang={uiLocale}>{ui.relevance} {Math.round(article.data.score * 100)}</span>}</div><h2><a href={articlePath(article.id, contentLanguage)}>{article.data.title}</a></h2><p>{article.data.summary}</p>{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list">{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}</div><a class="read-link" lang={uiLocale} href={articlePath(article.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">→</span></a></article></li>)}</ol>}</div> : <div class="empty-state orbit-empty" lang={uiLocale}><span class="signal-sweep" aria-hidden="true"><i></i></span><p class="orbit-label">{ui.monitoring}</p><h2>{ui.emptyTitle}</h2><p>{ui.emptyDescription}</p></div>}
</section>
