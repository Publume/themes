---
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import { languageHomePath, languageRssPath, siteConfig, ui } from '../lib/site'

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
---

<header class="site-header">
  <div class="ledger-rule" aria-hidden="true"></div>
  <div class="shell header-grid">
    <p class="edition-label">{ui.monitoring} · {ui.live}</p>
    <a class="brand" href={languageHomePath(contentLanguage)} aria-label={`${siteConfig.name} · ${ui.home}`}>{siteConfig.name}</a>
    <LanguageSwitcher contentLanguage={contentLanguage} />
  </div>
  <div class="shell navigation-row">
    <p>{siteConfig.tagline}</p>
    <nav aria-label={ui.primaryNavigation}>
      <a href={languageHomePath(contentLanguage)}>{ui.latest}</a>
      <a href={languageRssPath(contentLanguage)}>{ui.rss}</a>
      {siteConfig.contactUrl && <a href={siteConfig.contactUrl}>{ui.contact}</a>}
    </nav>
  </div>
</header>
<main id="main-content"><slot /></main>
<footer class="site-footer">
  <div class="shell footer-grid">
    <strong>{siteConfig.name}</strong>
    <div><p class="footer-label">{ui.disclosure}</p><p>{siteConfig.aiDisclosure}</p></div>
    <p>{siteConfig.footerText}</p>
  </div>
</footer>
