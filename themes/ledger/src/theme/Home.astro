---
import type { Article } from '../lib/articles'
import { articlePath, formatDate, siteConfig, ui, uiLocale } from '../lib/site'

type Props = { articles: readonly Article[]; contentLanguage: string }
const { articles, contentLanguage } = Astro.props
const [lead, ...remaining] = articles
const sourceCount = siteConfig.showSources
  ? new Set(articles.flatMap((article) => article.data.sourceUrls.map((url) => new URL(url).hostname))).size
  : 0
---

<section class="ledger-overview shell" lang={uiLocale}>
  <div class="overview-index"><span>{ui.latest}</span><b>{String(articles.length).padStart(2, '0')}</b></div>
  <div class="overview-title"><p class="label">{ui.published} / {ui.monitoring}</p><h1>{siteConfig.tagline}</h1><p>{siteConfig.description}</p></div>
  <dl class="overview-stats">{siteConfig.showSources && <div><dt>{ui.sources}</dt><dd>{sourceCount}</dd></div>}<div><dt>{ui.mode}</dt><dd>{ui.live}</dd></div></dl>
</section>
<section class="ledger-feed shell" aria-labelledby="latest-heading">
  <div class="ledger-heading" lang={uiLocale}><p class="label">{ui.published}</p><h2 id="latest-heading">{ui.latest}</h2><span>{String(articles.length).padStart(2, '0')}</span></div>
  {lead ? <>
    <article class="ledger-lead">
      <div class="lead-index"><span>01</span><time datetime={lead.data.publishedAt.toISOString()}>{formatDate(lead.data.publishedAt, contentLanguage)}</time></div>
      <div class="lead-title"><h2><a href={articlePath(lead.id, contentLanguage)}>{lead.data.title}</a></h2>{siteConfig.showTopics && lead.data.topics.length > 0 && <ul class="topic-list">{lead.data.topics.map((topic) => <li>{topic}</li>)}</ul>}</div>
      <div class="lead-summary"><p>{lead.data.summary}</p>{siteConfig.showScore && lead.data.score !== undefined && <p class="score" lang={uiLocale}>{ui.relevance} {Math.round(lead.data.score * 100)}</p>}<a class="read-link" lang={uiLocale} href={articlePath(lead.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">↗</span></a></div>
    </article>
    {remaining.length > 0 && <div class="table-head" lang={uiLocale} aria-hidden="true"><span lang="en">#</span><span>{ui.published}</span><span>{ui.latest}</span><span>{ui.readArticle}</span></div><ol class="ledger-list">{remaining.map((article, index) => <li><article class="ledger-row"><div class="row-index">{String(index + 2).padStart(2, '0')}</div><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, contentLanguage)}</time><div><h2 id={`ledger-row-title-${index + 2}`}><a href={articlePath(article.id, contentLanguage)}>{article.data.title}</a></h2><p>{article.data.summary}</p></div><a class="row-link" href={articlePath(article.id, contentLanguage)} aria-labelledby={`ledger-row-title-${index + 2}`}>↗</a></article></li>)}</ol>}
  </> : <div class="empty-state" lang={uiLocale}><span>00</span><h2>{ui.emptyTitle}</h2><p>{ui.emptyDescription}</p></div>}
</section>
{(siteConfig.newsletterUrl || siteConfig.sponsorUrl) && <aside class="shell ledger-actions" lang={uiLocale}><p class="label">{ui.latest}</p><div>{siteConfig.newsletterUrl && <a href={siteConfig.newsletterUrl}>{ui.newsletter} <span>↗</span></a>}{siteConfig.sponsorUrl && <a href={siteConfig.sponsorUrl}>{ui.sponsor} <span>↗</span></a>}</div></aside>}
