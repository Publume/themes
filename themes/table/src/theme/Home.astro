---
import type { Article } from '../lib/articles'
import { articlePath, formatDate, siteConfig, ui, uiLocale } from '../lib/site'

type Props = { articles: readonly Article[]; contentLanguage: string }
const { articles, contentLanguage } = Astro.props
const [lead, ...remaining] = articles
---

<section class="table-intro shell" lang={uiLocale}><div><p class="table-label">{ui.latest}</p><h1>{siteConfig.tagline}</h1></div><p>{siteConfig.description}</p></section>
<section class="table-feed shell" aria-labelledby="latest-heading"><div class="section-heading" lang={uiLocale}><span class="ornament" aria-hidden="true">✦</span><div><p class="table-label">{ui.published}</p><h2 id="latest-heading">{ui.latest}</h2></div><span class="ornament" aria-hidden="true">✦</span></div>{lead ? <><article class="table-lead"><div class="lead-plaque"><span>{formatDate(lead.data.publishedAt, contentLanguage)}</span><i aria-hidden="true"></i><span lang={uiLocale}>{ui.latest}</span></div><div class="lead-main"><h2><a href={articlePath(lead.id, contentLanguage)}>{lead.data.title}</a></h2><p>{lead.data.summary}</p>{siteConfig.showTopics && lead.data.topics.length > 0 && <ul class="topic-list">{lead.data.topics.map((topic) => <li>{topic}</li>)}</ul>}</div><div class="lead-action">{siteConfig.showScore && lead.data.score !== undefined && <span lang={uiLocale}>{ui.relevance} {Math.round(lead.data.score * 100)}</span>}<a class="read-link" lang={uiLocale} href={articlePath(lead.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">→</span></a></div></article>{remaining.length > 0 && <div class="menu-grid">{remaining.map((article, index) => <article class="menu-card"><div class="menu-meta"><span>{String(index + 2).padStart(2, '0')}</span><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, contentLanguage)}</time></div><h2><a href={articlePath(article.id, contentLanguage)}>{article.data.title}</a></h2><p>{article.data.summary}</p>{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list">{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}<a class="read-link" lang={uiLocale} href={articlePath(article.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">↗</span></a></article>)}</div>}</> : <div class="empty-state" lang={uiLocale}><span class="table-mark" aria-hidden="true"><i></i></span><h2>{ui.emptyTitle}</h2><p>{ui.emptyDescription}</p></div>}</section>
{(siteConfig.newsletterUrl || siteConfig.sponsorUrl) && <aside class="table-actions shell" lang={uiLocale}><span class="ornament" aria-hidden="true">✦</span><div><p class="table-label">{ui.latest}</p><h2>{siteConfig.tagline}</h2></div><div>{siteConfig.newsletterUrl && <a href={siteConfig.newsletterUrl}>{ui.newsletter} <span>↗</span></a>}{siteConfig.sponsorUrl && <a href={siteConfig.sponsorUrl}>{ui.sponsor} <span>↗</span></a>}</div></aside>}
