---
import FooterAttribution from '../components/FooterAttribution.astro'
import FooterNavigation from '../components/FooterNavigation.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import PrimaryNavigation from '../components/PrimaryNavigation.astro'
import { languageHomePath, siteConfig, ui, uiLocale } from '../lib/site'

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
---

<header lang={uiLocale} class="site-header"><div class="shell utility-row"><p>{siteConfig.description}</p><div class="desktop-navigation"><PrimaryNavigation contentLanguage={contentLanguage} /></div></div><div class="shell masthead"><span class="table-mark" aria-hidden="true"><i></i></span><a class="brand" href={languageHomePath(contentLanguage)} aria-label={`${siteConfig.name} · ${ui.home}`}>{siteConfig.name}</a><div class="desktop-language"><LanguageSwitcher contentLanguage={contentLanguage} /></div><details class="mobile-menu"><summary>{ui.primaryNavigation}<span aria-hidden="true">☰</span></summary><div class="mobile-menu-panel"><PrimaryNavigation contentLanguage={contentLanguage} /><LanguageSwitcher contentLanguage={contentLanguage} /></div></details></div></header>
<main id="main-content"><slot /></main>
<footer lang={uiLocale} class="site-footer"><div class="shell footer-grid"><div><p class="table-label">{ui.published}</p><strong>{siteConfig.name}</strong><p>{siteConfig.description}</p></div><FooterAttribution /></div><FooterNavigation contentLanguage={contentLanguage} /></footer>
