---
import FooterAttribution from '../components/FooterAttribution.astro'
import FooterNavigation from '../components/FooterNavigation.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import PrimaryNavigation from '../components/PrimaryNavigation.astro'
import { languageHomePath, siteConfig, ui, uiLocale } from '../lib/site'

type Props = { contentLanguage: string }
const { contentLanguage } = Astro.props
---

<div lang={uiLocale} class="score-ticker"><div class="shell"><strong><i aria-hidden="true"></i>{ui.live}</strong><span>{ui.latest} · {ui.mode}</span><span>{ui.monitoring}</span></div></div><header lang={uiLocale} class="site-header"><div class="shell header-inner"><a class="brand" href={languageHomePath(contentLanguage)} aria-label={`${siteConfig.name} · ${ui.home}`}><span class="score-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>{siteConfig.name}</span></a><p class="live-label"><i aria-hidden="true"></i>{ui.live}</p><div class="desktop-navigation"><PrimaryNavigation contentLanguage={contentLanguage} /></div><div class="desktop-language"><LanguageSwitcher contentLanguage={contentLanguage} /></div><details class="mobile-menu"><summary>{ui.primaryNavigation}<span aria-hidden="true">＋</span></summary><div class="mobile-menu-panel"><PrimaryNavigation contentLanguage={contentLanguage} /><LanguageSwitcher contentLanguage={contentLanguage} /></div></details></div></header>
<main id="main-content"><slot /></main>
<footer lang={uiLocale} class="site-footer"><div class="shell footer-grid"><div><p class="score-label">{ui.published}</p><strong>{siteConfig.name}</strong></div><FooterAttribution /></div><FooterNavigation contentLanguage={contentLanguage} /></footer>
