---
import type { Article } from '../lib/articles'
import { articlePath, formatDate, siteConfig, ui } from '../lib/site'

type Props = { articles: readonly Article[]; contentLanguage: string }
const { articles, contentLanguage } = Astro.props
---

<section class="studio-hero shell"><div class="hero-index" aria-hidden="true">{String(articles.length).padStart(2, '0')}</div><div class="hero-copy"><p class="studio-label">{ui.latest} · {ui.live}</p><h1>{siteConfig.tagline}</h1><p>{siteConfig.description}</p></div><div class="hero-stamp" aria-hidden="true"><span>{ui.monitoring}</span><i></i></div></section>
<section class="studio-feed shell" aria-labelledby="latest-heading"><div class="section-heading"><p class="studio-label">{ui.published}</p><h2 id="latest-heading">{ui.latest}</h2><span>{String(articles.length).padStart(2, '0')}</span></div>{articles.length > 0 ? <div class="poster-grid">{articles.map((article, index) => <article class:list={['poster-card', { featured: index === 0 }]}><div class="poster-top"><span>{String(index + 1).padStart(2, '0')}</span><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, contentLanguage)}</time></div><h2><a href={articlePath(article.id, contentLanguage)}>{article.data.title}</a></h2><p>{article.data.summary}</p>{siteConfig.showTopics && article.data.topics.length > 0 && <ul class="topic-list" aria-label={ui.topics}>{article.data.topics.map((topic) => <li>{topic}</li>)}</ul>}<div class="poster-footer">{siteConfig.showScore && article.data.score !== undefined && <span>{ui.relevance} {Math.round(article.data.score * 100)}</span>}<a class="read-link" href={articlePath(article.id, contentLanguage)}>{ui.readArticle} <span aria-hidden="true">↗</span></a></div></article>)}</div> : <div class="empty-state"><span class="studio-mark" aria-hidden="true"><i></i></span><h2>{ui.emptyTitle}</h2><p>{ui.emptyDescription}</p></div>}</section>
{(siteConfig.newsletterUrl || siteConfig.sponsorUrl) && <aside class="studio-actions shell"><p>{siteConfig.tagline}</p><div>{siteConfig.newsletterUrl && <a href={siteConfig.newsletterUrl}>{ui.newsletter} <span>↗</span></a>}{siteConfig.sponsorUrl && <a href={siteConfig.sponsorUrl}>{ui.sponsor} <span>↗</span></a>}</div></aside>}
