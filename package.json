{
  "name": "@publume/themes",
  "version": "0.1.0",
  "private": true,
  "description": "A shared multilingual site runtime with composable Publume visual themes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Publume/themes.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "contract": "bun scripts/check-contract.ts",
    "dev:theme": "bun scripts/dev-theme.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "quality": "biome check .",
    "themes:check": "bun scripts/run-themes.ts",
    "check": "bun run quality && bun run typecheck && bun run contract && bun run themes:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "latest",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  }
}
